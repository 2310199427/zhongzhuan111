# 本地离线开发默认开启。只有明确改为 false 时才会调用 HTTP 客户端。
BUILD_DRY_RUN=true

# 以下全部是不可路由或脱敏占位值，回公司后按真实接口文档替换。
BUILD_PLATFORM_BASE_URL=https://build-platform.example.invalid
BUILD_PLATFORM_CREATE_API_NAME=CREATE_BUILD_API
BUILD_PLATFORM_STATUS_API_NAME=QUERY_BUILD_STATUS_API
BUILD_PLATFORM_LOGS_API_NAME=QUERY_BUILD_LOGS_API
BUILD_PLATFORM_ARTIFACTS_API_NAME=QUERY_BUILD_ARTIFACTS_API
BUILD_PLATFORM_CREATE_PATH=/TODO/CREATE_BUILD_API
BUILD_PLATFORM_STATUS_PATH=/TODO/QUERY_BUILD_STATUS_API/{task_id}
BUILD_PLATFORM_LOGS_PATH=/TODO/QUERY_BUILD_LOGS_API/{task_id}
BUILD_PLATFORM_ARTIFACTS_PATH=/TODO/QUERY_BUILD_ARTIFACTS_API/{task_id}
BUILD_PLATFORM_TOKEN=replace-with-placeholder-token
BUILD_PLATFORM_TIMEOUT_SECONDS=30

BUILD_DEFAULT_NODE_BRANCH_MODE=same_as_git_branch
BUILD_DEFAULT_INNER_VERSION_RUET=<INNER_VERSION_RUET>
BUILD_DEFAULT_GIT_MARP_BRANCH=<GIT_MARP_BRANCH>
BUILD_DEFAULT_GIT_MARP_NO=<GIT_MARP_COMMIT_ID>
BUILD_DEFAULT_UNLOCK_UART_STATUE=<UNLOCK_UART_STATUE>
BUILD_DEFAULT_CBB_STATUS=
BUILD_DEFAULT_RTOS_STATUS=false
BUILD_DEFAULT_TAILOR_STATUS=false
BUILD_DEFAULT_COMPILE_DPD_FLAG=false
BUILD_DEFAULT_FPGA_STATUS=false
BUILD_DEFAULT_GIT_BRANCH_DPD=<GIT_BRANCH_DPD>
BUILD_DEFAULT_PCK_MODEL=<PCK_MODEL>
BUILD_DEFAULT_PROJECT_NAME=<PROJECT_NAME>
BUILD_DEFAULT_ENV_ID_MARP=
BUILD_DEFAULT_ENV_ID_RTOS_MARP=
BUILD_DEFAULT_QEMU_FLAG=false
BUILD_DEFAULT_RUET_WHITEBOX_FLAG=0
BUILD_DEFAULT_UPLOADING_EXTERNAL_FILE_FLAG=true
BUILD_DEFAULT_CBB_BSP_TYPE=

# 仅供离线开发。生产必须替换 EnvironmentActorProvider，而不是信任这些变量。
BUILD_ACTOR_NAME=Mock Developer
BUILD_ACTOR_EMPLOYEE_NO=MOCK-EMPLOYEE-000001
